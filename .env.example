# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Locally: docker run -p 5432:5432 postgres,
# or use a managed Postgres (Neon, Supabase, Railway, RDS).
DATABASE_URL="postgresql://user:password@localhost:5432/boxxera?schema=public"

# --- Auth.js / NextAuth ------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Storage (S3-compatible) -------------------------------------------------
# Used for license documents and fighter photos. Any S3-compatible provider
# works (AWS S3, Cloudflare R2, Backblaze B2).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BOXXERA"
NEXT_PUBLIC_DEFAULT_COUNTRY="MX"
